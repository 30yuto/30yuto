@import url('https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;700&display=swap');

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: 'Noto Sans JP', sans-serif;
  background-color: #f0f8ff;
}

.poster {
  max-width: 800px;
  margin: 0 auto;
  padding: 20px;
  background: linear-gradient(135deg, #c9e6ff 0%, #a1d4ff 100%);
  border-radius: 10px;
  box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
  position: relative;
  overflow: hidden;
}

.poster::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="100" height="100" viewBox="0 0 100 100"><path fill="rgba(255,255,255,0.2)" d="M50 0 L100 50 L50 100 L0 50 Z"/></svg>');
  opacity: 0.3;
  z-index: 0;
}

.poster-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 30px;
  position: relative;
  z-index: 1;
}

.logo, .mascot {
  width: 100px;
  height: 100px;
}

.school-logo, .mascot-img {
  width: 100%;
  height: auto;
  object-fit: contain;
}

.title-container {
  text-align: center;
  flex-grow: 1;
  padding: 0 20px;
}

.main-title {
  font-size: 2.5rem;
  color: #003366;
  margin-bottom: 5px;
  text-shadow: 2px 2px 4px rgba(255, 255, 255, 0.7);
}

.sub-title {
  font-size: 1.8rem;
  color: #003366;
  margin-bottom: 10px;
}

.slogan {
  font-size: 1.2rem;
  color: #0066cc;
  font-weight: bold;
}

.event-details {
  background-color: rgba(255, 255, 255, 0.7);
  padding: 20px;
  border-radius: 8px;
  margin-bottom: 30px;
  position: relative;
  z-index: 1;
}

.details-title {
  font-size: 1.5rem;
  color: #000;
  text-align: center;
  margin-bottom: 15px;
}

.date-time {
  font-size: 1.3rem;
  margin-bottom: 15px;
  text-align: center;
}

.venue {
  font-size: 1.3rem;
  text-align: center;
}

.event-content {
  background-color: rgba(255, 255, 255, 0.7);
  padding: 20px;
  border-radius: 8px;
  position: relative;
  z-index: 1;
}

.content-title {
  font-size: 1.5rem;
  color: #000;
  margin-bottom: 15px;
}

@media (max-width: 768px) {
  .poster-header {
    flex-direction: column;
    align-items: center;
  }
  
  .logo, .mascot {
    margin-bottom: 15px;
  }
  
  .main-title {
    font-size: 2rem;
  }
  
  .sub-title {
    font-size: 1.5rem;
  }
  
  .date-time, .venue {
    font-size: 1.1rem;
  }
}