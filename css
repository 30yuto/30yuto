@import url('https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;700&display=swap');

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Noto Sans JP', sans-serif;
    background-color: #ffffff;
    color: #333;
    line-height: 1.6;
}

.container {
    max-width: 800px;
    margin: 0 auto;
    background-color: #ffffff;
    position: relative;
    overflow: hidden;
    box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
}

/* Header Styles */
header {
    width: 100%;
}

.header-top {
    background-color: #6699cc;
    padding: 15px 20px;
    position: relative;
    overflow: hidden;
}

.header-top h1 {
    color: white;
    font-size: 24px;
    font-weight: 700;
    z-index: 2;
    position: relative;
}

.geometric-pattern {
    position: absolute;
    top: 0;
    right: 0;
    width: 300px;
    height: 100%;
    background-image: linear-gradient(120deg, transparent 30%, rgba(255, 255, 255, 0.1) 70%);
    z-index: 1;
}

.header-bottom {
    background-color: #0a4595;
    padding: 10px 20px;
    color: white;
}

.feature-text {
    font-size: 16px;
    font-weight: normal;
}

/* Main Content Styles */
main {
    padding: 20px;
    position: relative;
}

.festival-title {
    margin: 20px 0;
}

.festival-title h2 {
    color: #0a4595;
    font-size: 42px;
    font-weight: bold;
    text-align: center;
    letter-spacing: 2px;
    border: 3px solid #0a4595;
    padding: 10px;
    border-radius: 10px;
}

.content-wrapper {
    display: flex;
    margin-top: 20px;
}

.main-content {
    flex: 3;
}

.side-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-left: 20px;
}

.subtitle {
    text-align: center;
    margin-bottom: 30px;
}

.subtitle h3 {
    font-size: 24px;
    margin-bottom: 5px;
}

.subtitle p {
    font-size: 18px;
}

.festival-details {
    margin-top: 20px;
}

.blue-bar {
    background-color: #0a4595;
    padding: 8px 15px;
    margin: 20px 0;
    position: relative;
}

.blue-bar h4 {
    color: white;
    font-size: 18px;
    font-weight: bold;
}

.blue-bar::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    width: 5px;
    height: 100%;
    background-color: #0a4595;
}

.details-content {
    padding: 10px 0;
    font-size: 18px;
    line-height: 1.8;
}

.event-heading {
    color: #4682b4;
    font-size: 20px;
    font-weight: bold;
    padding-bottom: 5px;
    border-bottom: 2px solid #4682b4;
    margin: 20px 0 10px;
}

.event-status {
    padding: 10px 0;
    font-size: 18px;
}

.floor-events {
    margin-top: 20px;
}

.floor {
    display: flex;
    margin-bottom: 15px;
}

.floor-number {
    flex: 0 0 40px;
    background-color: #0a4595;
    color: white;
    text-align: center;
    padding: 5px;
    font-weight: bold;
    display: flex;
    align-items: center;
    justify-content: center;
}

.floor-content {
    flex: 1;
    padding: 5px 10px;
    font-size: 16px;
}

/* School Emblem and Mascot */
.school-emblem {
    margin-bottom: 30px;
}

.emblem-image {
    width: 120px;
    height: 120px;
    background-color: #f0f0f0;
    border-radius: 50%;
    background-image: url('https://hebbkx1anhila5yf.public.blob.vercel-storage.com/%E3%83%96%E3%83%AB%E3%83%BC%20%E3%83%9B%E3%83%AF%E3%82%A4%E3%83%88%20%E3%82%B7%E3%83%B3%E3%83%97%E3%83%AB%20%E7%A4%BE%E5%86%85%E5%A0%B1%20%E7%89%B9%E9%9B%86%E8%A8%98%E4%BA%8B%20%E3%83%93%E3%82%B8%E3%83%8D%E3%82%B9%20A4%E6%96%87%E6%9B%B8%20%E7%B8%A6%20%281%29-6SkOS8D072CLQ4WI4595M8ZR8vI3uf.png');
    background-size: cover;
    background-position: right top;
    background-repeat: no-repeat;
}

.mascot-image {
    width: 120px;
    height: 120px;
    background-image: url('https://hebbkx1anhila5yf.public.blob.vercel-storage.com/%E3%83%96%E3%83%AB%E3%83%BC%20%E3%83%9B%E3%83%AF%E3%82%A4%E3%83%88%20%E3%82%B7%E3%83%B3%E3%83%97%E3%83%AB%20%E7%A4%BE%E5%86%85%E5%A0%B1%20%E7%89%B9%E9%9B%86%E8%A8%98%E4%BA%8B%20%E3%83%93%E3%82%B8%E3%83%8D%E3%82%B9%20A4%E6%96%87%E6%9B%B8%20%E7%B8%A6%20%281%29-6SkOS8D072CLQ4WI4595M8ZR8vI3uf.png');
    background-size: cover;
    background-position: right center;
    background-repeat: no-repeat;
}

/* Footer */
footer {
    margin-top: 40px;
    padding-top: 20px;
    border-top: 1px solid #ddd;
}

.footer-icons {
    display: flex;
    justify-content: space-between;
}

.icon {
    width: 30px;
    height: 30px;
    background-color: #0a4595;
    border-radius: 50%;
}

/* Background Pattern */
body::before {
    content: "";
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: linear-gradient(120deg, #f0f0f0 0%, #ffffff 100%);
    z-index: -1;
}

/* Responsive Design */
@media (max-width: 768px) {
    .content-wrapper {
        flex-direction: column;
    }
    
    .side-content {
        flex-direction: row;
        justify-content: space-around;
        margin-top: 30px;
        padding-left: 0;
    }
    
    .festival-title h2 {
        font-size: 32px;
    }
}